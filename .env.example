# Server Environment Configuration
PORT=4000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# Database Connection (Supabase PostgreSQL / Local)
# Supabase Transaction Pooler (Session / Transaction mode on port 6543):
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Supabase Direct / Session Connection (Port 5432 for migrations & db push):
# DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL="file:./dev.db"
DIRECT_URL=""

# Authentication & JWT Secrets
JWT_ACCESS_SECRET="dakshin_dev_access_secret_32_characters_long_min"
JWT_REFRESH_SECRET="dakshin_dev_refresh_secret_32_characters_long_min"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY="30d"

# Farmer Toll-Free Helpline
HELPLINE_NUMBER="1800-425-76884"

# SMS OTP Provider (dev uses MOCK provider which prints to console; set to TWILIO or MSG91 in production)
SMS_PROVIDER=MOCK
MSG91_AUTH_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Razorpay Test Mode Keys (Escrow Payment Simulation)
RAZORPAY_KEY_ID="rzp_test_mock_dakshin_key"
RAZORPAY_KEY_SECRET="rzp_test_mock_secret_dakshin"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_dakshin"

# Open Data Govt API for Mandi Rates
DATA_GOV_IN_API_KEY=""

# Storage (LOCAL or S3/CLOUDINARY)
STORAGE_TYPE=LOCAL
UPLOAD_DIR="./uploads"
