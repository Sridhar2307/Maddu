// Prisma Schema for DakshinAgriHub Backend
// Supports SQLite for zero-friction local development and PostgreSQL for Docker/Cloud deployment

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  name        String   @default("Farmer")
  roles       String   @default("BUYER") // Comma-separated or JSON string e.g. "BUYER,SELLER"
  state       String   @default("TN")
  district    String   @default("Erode")
  language    String   @default("ta")
  isBanned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sellerProfile     SellerProfile?
  refreshTokens     RefreshToken[]
  listings          Listing[]
  fodderListings    FodderListing[]
  equipmentListings EquipmentListing[]
  buyerOrders       Order[]             @relation("BuyerOrders")
  sellerOrders      Order[]             @relation("SellerOrders")
  favorites         Favorite[]
  enquiries         Enquiry[]
  truckBookings     TruckBooking[]
  mandiAlerts       MandiAlert[]
  vetRequests       VetRequest[]
  schemeApplications SchemeApplication[]
  buyerReviews      Review[]            @relation("BuyerReviews")
  sellerReviews     Review[]            @relation("SellerReviews")
  reportsFiled      Report[]            @relation("UserReports")
}

model SellerProfile {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  village         String
  district        String
  stateId         String
  idProofUrl      String?
  status          String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Listing {
  id              String         @id @default(uuid())
  sellerId        String
  seller          User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title           String
  category        String         @default("CATTLE") // CATTLE, BUFFALO, GOAT, SHEEP, POULTRY
  breed           String
  stateId         String
  district        String
  price           Int
  ageMonths       Int            @default(36)
  dailyYield      Float          @default(0.0)
  lactation       Int            @default(0)
  pregnancyStatus String         @default("Not Pregnant")
  estimatedWeight Float          @default(300.0)
  heartGirthCm    Float?
  bodyLengthCm    Float?
  earTagId        String?
  earTagVerified  Boolean        @default(false)
  diet            String         @default("Green fodder, straw, minerals")
  description     String         @default("")
  status          String         @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, SOLD, REMOVED
  viewCount       Int            @default(0)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  images          ListingImage[]
  vaccinations    Vaccination[]
  orders          Order[]
  favorites       Favorite[]
  enquiries       Enquiry[]
  reports         Report[]

  @@index([stateId, breed, status])
  @@index([price])
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Vaccination {
  id          String   @id @default(uuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name        String
  date        String
  certifiedBy String?
  createdAt   DateTime @default(now())
}

model FodderListing {
  id            String   @id @default(uuid())
  sellerId      String
  seller        User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title         String
  type          String   // Green Fodder, Dry Roughage, Silage, Concentrate
  stateId       String
  district      String
  pricePerUnit  String
  unit          String   @default("kg")
  moisture      String   @default("15%")
  crudeProtein  String   @default("10%")
  minOrder      String   @default("1 Tonne")
  deliveryTerms String   @default("Doorstep delivery")
  imageUrl      String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EquipmentListing {
  id          String   @id @default(uuid())
  sellerId    String
  seller      User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title       String
  serviceType String
  stateId     String
  district    String
  ratePerHour String
  ratePerDay  String?
  availability String  @default("Immediate")
  imageUrl    String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

model Enquiry {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  message   String
  status    String   @default("SENT") // SENT, READ, REPLIED
  createdAt DateTime @default(now())
}

model Order {
  id                 String       @id @default(uuid())
  listingId          String
  listing            Listing      @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyerId            String
  buyer              User         @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  sellerId           String
  seller             User         @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  amount             Int
  status             String       @default("CREATED") // CREATED, PAID_ESCROW, DISPATCHED, DELIVERED, RELEASED, DISPUTED, REFUNDED, CANCELLED
  razorpayOrderId    String?
  razorpayPaymentId  String?
  disputeReason      String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  timeline           OrderEvent[]
  truckBooking       TruckBooking?
  review             Review?

  @@index([buyerId])
  @@index([sellerId])
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model TruckBooking {
  id           String   @id @default(uuid())
  orderId      String?  @unique
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDistrict String
  toDistrict   String
  km           Int
  vehicleType  String   // BOLERO, TRUCK_6WHEEL, ISLAND_VESSEL
  price        Int
  status       String   @default("BOOKED") // BOOKED, IN_TRANSIT, COMPLETED, CANCELLED
  pickupDate   String
  contactPhone String
  createdAt    DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User     @relation("BuyerReviews", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  rating    Int      @default(5) // 1-5
  comment   String?
  createdAt DateTime @default(now())
}

model MandiRate {
  id          String   @id @default(uuid())
  market      String
  state       String
  commodity   String
  minPrice    String
  maxPrice    String
  modalPrice  String
  unit        String   @default("Quintal")
  arrivalDate String
  fetchedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([state, commodity])
}

model Shandy {
  id            String   @id
  name          String
  state         String
  stateId       String
  district      String
  dayOfWeek     String
  timings       String
  capacity      String
  primaryBreeds String   // Comma-separated or JSON
  entryFee      String
  highlight     String
  lat           Float
  lng           Float
  createdAt     DateTime @default(now())
}

model MandiAlert {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commodity      String
  market         String?
  thresholdPrice Float?
  channel        String   @default("SMS") // SMS, WHATSAPP
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Scheme {
  id           String              @id @default(uuid())
  name         String
  authority    String              @default("State") // Central, State
  stateId      String?
  description  String
  eligibility  String
  benefit      String
  applyUrl     String
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  applications SchemeApplication[]
}

model SchemeApplication {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schemeId  String
  scheme    Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  status    String   @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED
  notes     String?
  createdAt DateTime @default(now())
}

model VetRequest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  species   String   @default("COW")
  symptoms  String
  photoUrls String   @default("[]") // JSON string of urls
  status    String   @default("OPEN") // OPEN, ANSWERED, CLOSED
  reply     String?
  vetId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  meta      String?  // JSON string
  ip        String?
  createdAt DateTime @default(now())
}

model Report {
  id          String   @id @default(uuid())
  reporterId  String
  reporter    User     @relation("UserReports", fields: [reporterId], references: [id], onDelete: Cascade)
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reason      String
  status      String   @default("PENDING") // PENDING, RESOLVED, DISMISSED
  createdAt   DateTime @default(now())
}
