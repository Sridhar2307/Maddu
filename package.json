{
  "name": "dakshin-agrihub-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"blue,green\" \"npm --workspace=@dakshin/api run dev\" \"npm --workspace=@dakshin/web run dev\"",
    "dev:api": "npm --workspace=@dakshin/api run dev",
    "dev:web": "npm --workspace=@dakshin/web run dev",
    "build": "npm run --workspaces build",
    "test": "npm --workspace=@dakshin/api test",
    "prisma:generate": "npm --workspace=@dakshin/api run prisma:generate",
    "prisma:push": "npm --workspace=@dakshin/api run prisma:push",
    "prisma:seed": "npm --workspace=@dakshin/api run prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
